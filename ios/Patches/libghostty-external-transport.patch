diff --git a/src/termio/External.zig b/src/termio/External.zig
new file mode 100644
index 0000000..b570586
--- /dev/null
+++ b/src/termio/External.zig
@@ -0,0 +1,103 @@
+//! External terminal IO backend for embedders that own their transport.
+//!
+//! Output is supplied through Termio.processOutput by the embedding API.
+//! Writes and resizes are forwarded to host callbacks.
+const External = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+config: Config,
+
+pub const WriteFn = *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void;
+pub const ResizeFn = *const fn (?*anyopaque, u16, u16) callconv(.c) void;
+
+pub const Config = struct {
+    userdata: ?*anyopaque = null,
+    write: WriteFn,
+    resize: ResizeFn,
+};
+
+pub const ThreadData = struct {
+    pub fn deinit(_: *ThreadData, _: Allocator) void {}
+
+    pub fn changeConfig(_: *ThreadData, _: *termio.DerivedConfig) void {}
+};
+
+pub fn init(config: Config) External {
+    return .{ .config = config };
+}
+
+pub fn deinit(_: *External) void {}
+
+pub fn initTerminal(self: *External, value: *terminal.Terminal) void {
+    self.resize(
+        .{ .columns = value.cols, .rows = value.rows },
+        .{ .width = value.width_px, .height = value.height_px },
+    ) catch {};
+}
+
+pub fn threadEnter(
+    _: *External,
+    _: Allocator,
+    _: *termio.Termio,
+    data: *termio.Termio.ThreadData,
+) !void {
+    data.backend = .{ .external = .{} };
+}
+
+pub fn threadExit(_: *External, _: *termio.Termio.ThreadData) void {}
+
+pub fn focusGained(_: *External, _: *termio.Termio.ThreadData, _: bool) !void {}
+
+pub fn resize(
+    self: *External,
+    grid_size: renderer.GridSize,
+    _: renderer.ScreenSize,
+) !void {
+    self.config.resize(
+        self.config.userdata,
+        grid_size.columns,
+        grid_size.rows,
+    );
+}
+
+pub fn queueWrite(
+    self: *External,
+    _: Allocator,
+    _: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    if (!linefeed) {
+        self.config.write(self.config.userdata, data.ptr, data.len);
+        return;
+    }
+
+    var converted: std.ArrayList(u8) = .empty;
+    defer converted.deinit(std.heap.c_allocator);
+    for (data) |byte| {
+        try converted.append(std.heap.c_allocator, byte);
+        if (byte == '\r') try converted.append(std.heap.c_allocator, '\n');
+    }
+    self.config.write(self.config.userdata, converted.items.ptr, converted.items.len);
+}
+
+pub fn childExitedAbnormally(
+    _: *External,
+    _: Allocator,
+    _: *terminal.Terminal,
+    _: u32,
+    _: u64,
+) !void {}
+
+pub fn getProcessInfo(
+    _: *External,
+    comptime info: ProcessInfo,
+) ?ProcessInfo.Type(info) {
+    return null;
+}
